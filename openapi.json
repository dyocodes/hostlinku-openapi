{
  "openapi": "3.1.0",
  "info": {
    "title": "Hostlinku AI Gateway API",
    "version": "0.1.0",
    "description": "Unified AI gateway supporting OpenAI Chat Completions (/v1/chat/completions), Anthropic Messages (/v1/messages), OpenAI Responses (/v1/responses), model discovery (/v1/models), and public USD pricing catalog (/api/public/models).",
    "contact": {
      "name": "Hostlinku Documentation",
      "url": "https://docs.hostlinku.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.hostlinku.com",
      "description": "Hostlinku Production Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hostlinku API key (`sk-...`) created in https://console.hostlinku.com"
      },
      "anthropicKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Hostlinku API key (`sk-...`) passed via Anthropic-style `x-api-key` header"
      }
    }
  },
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "listAuthorizedModels",
        "summary": "List models available for your API key's Service Mode",
        "security": [{ "bearerAuth": [] }, { "anthropicKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "OpenAI-compatible list of available model objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": { "type": "string", "example": "list" },
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid API key" }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "OpenAI-compatible Chat Completions (supports SSE streaming)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": { "type": "string", "example": "gpt-5-5" },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["system", "developer", "user", "assistant", "tool"] },
                        "content": {}
                      }
                    }
                  },
                  "stream": { "type": "boolean", "default": false },
                  "max_tokens": { "type": "integer", "example": 256 },
                  "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Chat completion JSON response or SSE stream" },
          "400": { "description": "Invalid request or max_tokens exceeds model limit" },
          "401": { "description": "Unauthorized" },
          "402": { "description": "Insufficient balance or API key spending limit reached" },
          "404": { "description": "Model slug not found" },
          "422": { "description": "Validation failed" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "createAnthropicMessage",
        "summary": "Anthropic Messages API (supports Claude Code, prompt caching, and SSE streaming)",
        "security": [{ "anthropicKeyAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "default": "2023-06-01" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "max_tokens", "messages"],
                "properties": {
                  "model": { "type": "string", "example": "claude-haiku-4-5" },
                  "max_tokens": { "type": "integer", "example": 256 },
                  "stream": { "type": "boolean", "default": false },
                  "system": {},
                  "messages": { "type": "array", "items": { "type": "object" } },
                  "thinking": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Anthropic message JSON response or SSE stream" },
          "400": { "description": "invalid_request_error" },
          "401": { "description": "authentication_error" },
          "402": { "description": "billing_error" },
          "404": { "description": "not_found_error" },
          "429": { "description": "rate_limit_error" }
        }
      }
    },
    "/v1/messages/count_tokens": {
      "post": {
        "operationId": "countAnthropicMessageTokens",
        "summary": "Count input tokens without deducting USD balance",
        "security": [{ "anthropicKeyAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": { "type": "string", "example": "claude-haiku-4-5" },
                  "messages": { "type": "array", "items": { "type": "object" } },
                  "system": {},
                  "tools": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token count result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "input_tokens": { "type": "integer", "example": 16 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "createOpenAIResponse",
        "summary": "OpenAI Responses API (stateless; send full history in input with store: false)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "input"],
                "properties": {
                  "model": { "type": "string", "example": "gpt-5-5" },
                  "input": {},
                  "instructions": { "type": "string" },
                  "max_output_tokens": { "type": "integer", "example": 256 },
                  "stream": { "type": "boolean", "default": false },
                  "store": { "type": "boolean", "default": false },
                  "tools": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Responses API JSON output or SSE stream" },
          "400": { "description": "invalid_request_error" },
          "401": { "description": "authentication_error" },
          "402": { "description": "insufficient_quota" },
          "404": { "description": "not_found_error" },
          "429": { "description": "rate_limit_error" }
        }
      }
    },
    "/api/public/models": {
      "get": {
        "operationId": "getPublicModelCatalog",
        "summary": "Fetch public model catalog and live USD pricing across Service Modes (no auth required)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Public catalog with live USD rates per Service Mode"
          }
        }
      }
    }
  }
}
